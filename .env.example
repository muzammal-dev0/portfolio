# Optional: canonical site URL for Open Graph (e.g. https://yoursite.com)
# VITE_SITE_URL=

# Server-only chatbot vars (do NOT prefix with VITE_)
# Copy to `.env` for local dev with `vercel dev` / your host
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail SMTP — send alerts to your inbox (App Password required; enable 2FA first)
# SMTP_USER = Gmail account that sends
# SMTP_PASS = 16-char Google App Password for SMTP_USER
# NOTIFY_EMAIL_TO = inbox that receives lead / unknown-question alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
# Optional — defaults to SMTP_USER
# NOTIFY_EMAIL_FROM=

# Optional rate limit for /api/chat (requests per IP per minute)
CHAT_RATE_LIMIT_PER_MIN=10
